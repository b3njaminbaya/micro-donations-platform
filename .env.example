# Copy this file to .env AT THE REPO ROOT for local development and fill in
# real values (not server/.env — the app always runs as `server.app` from the
# repo root, and python-dotenv resolves relative to that). Never commit the
# actual .env file.

# Flask
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=
# If DATABASE_URL is left blank, the app falls back to a local SQLite database
# at ./instance/micro_donations.db (repo root).
FLASK_DEBUG=1

# M-Pesa Daraja (sandbox: https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Include the callback secret as a query param, e.g.:
#   MPESA_CALLBACK_URL=https://your-api.example.com/api/mpesa/callback?token=<same value as MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=replace-with-a-long-random-string

# Frontend (client/.env.local)
# Not 5000 — macOS's AirPlay Receiver squats on port 5000 by default and will
# silently swallow requests instead of Flask. Run `flask run --port 5050` and
# point here, or disable AirPlay Receiver in System Settings if you'd rather
# keep 5000.
REACT_APP_API_URL=http://localhost:5050/api

# Recurring donations: `python -m server.jobs.run_recurring_donations` charges
# every subscription that's due. It's a standalone script, not run by the web
# process — schedule it separately (e.g. a Render "Cron Job" resource, or any
# host's cron) to run daily, with the same env vars as the web service.
